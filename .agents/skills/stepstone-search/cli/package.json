{
  "name": "stepstone-cli",
  "version": "1.0.0",
  "description": "CLI for searching StepStone.de (Germany) via its public result-list and job pages — zero runtime dependencies. Personal use only.",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "stepstone-search": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "STEPSTONE_LIVE=1 bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "1.3.14"
  }
}
